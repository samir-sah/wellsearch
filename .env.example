# ---------------------------------------------------------------------------
# NixSearch configuration
#
# Copy to `.env` and adjust. Every value below is optional: the defaults in
# src/config/config.js are the same as the ones shown here. Values are
# validated at startup, so a typo fails fast with a readable message instead
# of producing a subtly broken index.
# ---------------------------------------------------------------------------

# --- HTTP server -----------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated exact origins. Wildcards are not supported; empty disables CORS.
CORS_ORIGINS=http://localhost:3001

# Live Wikipedia search (from the supplied Wikipedia Search Engine codebase).
# Set SEARCH_SOURCE=local to search your existing persisted crawler index instead.
SEARCH_SOURCE=wikipedia
# Each lookup/download is bounded; max 4000ms keeps the two stages within the UI timeout.
WIKIPEDIA_REQUEST_TIMEOUT_MS=3500
WIKIPEDIA_CACHE_TTL_MS=300000
WIKIPEDIA_MAX_CACHED_ARTICLES=250
WIKIPEDIA_MAX_CONCURRENT_SEARCHES=4

# --- Crawler ---------------------------------------------------------------
# Number of concurrent workers pulling from the shared URL frontier.
CRAWLER_CONCURRENCY=8
# Hard ceiling on pages fetched per crawl job.
MAX_PAGES=500
# 0 = only the seed URLs, 1 = seeds + their links, ...
MAX_DEPTH=2
# Per-request timeout in milliseconds.
REQUEST_TIMEOUT=10000
# Retries for transient failures (network errors, 429, 5xx).
MAX_RETRIES=2
# Politeness delay between two requests to the *same* host (ms).
CRAWL_DELAY_MS=250
# Maximum number of pages fetched from a single host per job (0 = unlimited).
MAX_PAGES_PER_HOST=100
# Stop following links that leave the hosts of the seed URLs.
SAME_HOST_ONLY=false
# Download cap per response; larger bodies are truncated, not rejected.
MAX_CONTENT_BYTES=2097152
MAX_REDIRECTS=5
# ALLOW_PRIVATE_NETWORK is honored only under NODE_ENV=test.
ALLOW_PRIVATE_NETWORK=false
# Fetch and honour /robots.txt (User-agent + Disallow + Crawl-delay).
RESPECT_ROBOTS=true
USER_AGENT=NixSearchBot/1.0 (+https://github.com/nixsearch)
# Seed URLs used when POST /api/crawl is called without an explicit list.
SEED_URLS=

# --- Okapi BM25 ------------------------------------------------------------
# Term frequency saturation. Typical range 1.2 - 2.0.
BM25_K1=1.5
# Document length normalisation. 0 = off, 1 = full.
BM25_B=0.75

# --- Indexing --------------------------------------------------------------
DATA_DIR=data
# Store term positions (needed for phrase queries).
INDEX_POSITIONS=true
# Cap on positions stored per (term, document) pair to bound index size.
MAX_POSITIONS_PER_TERM=64
# Characters of extracted page text kept for snippet generation.
MAX_STORED_TEXT=20000
# Field weights: a title occurrence counts N times in the term frequency.
TITLE_WEIGHT=3
DESCRIPTION_WEIGHT=2
BODY_WEIGHT=1
# Periodic persistence: flush when either threshold is reached.
PERSIST_INTERVAL_MS=15000
PERSIST_BATCH_SIZE=25
# Skip documents whose extracted text is shorter than this (boilerplate pages).
MIN_DOCUMENT_LENGTH=20

# --- Search ----------------------------------------------------------------
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=50
SEARCH_MAX_QUERY_LENGTH=512
SEARCH_MAX_QUERY_TERMS=32
SNIPPET_LENGTH=280
# Multiplier applied to terms that are part of a "quoted phrase".
PHRASE_BOOST=2
# Suggest alternative spellings when a query returns nothing.
SEARCH_SUGGESTIONS=true
MIN_TOKEN_LENGTH=1
MAX_TOKEN_LENGTH=48
STEMMING=true
STOP_WORDS=true
STOP_WORDS_EXTRA=

# --- Logging ---------------------------------------------------------------
# silent | error | warn | info | debug
LOG_LEVEL=info
# pretty | json  (json is the default when NODE_ENV=production)
LOG_FORMAT=pretty

# --- API surface -----------------------------------------------------------
# Defaults to false in production. If enabled there, ADMIN_TOKEN must be 32+ characters.
CRAWL_API_ENABLED=true
# POST /api/crawl and POST /api/crawl/stop accept Bearer or x-admin-token authentication.
ADMIN_TOKEN=
# Simple in-memory rate limits (requests per window, per IP).
RATE_LIMIT_WINDOW_MS=60000
SEARCH_RATE_LIMIT=120
CRAWL_RATE_LIMIT=5
BODY_LIMIT=64kb

# --- HTTP connection safety ------------------------------------------------
SERVER_REQUEST_TIMEOUT_MS=30000
SERVER_HEADERS_TIMEOUT_MS=15000
SERVER_KEEP_ALIVE_TIMEOUT_MS=5000
SERVER_SHUTDOWN_TIMEOUT_MS=10000
