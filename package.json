{
  "name": "wellsearch",
  "version": "1.0.0",
  "private": true,
  "description": "WellSearch - live Wikipedia search with BM25 ranking and an optional persistent web crawler",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samir-sah/wellsearch.git"
  },
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "validate": "npm test && npm --prefix frontend test && npm --prefix frontend run lint && npm --prefix frontend run typecheck && npm --prefix frontend run build"
  },
  "keywords": [
    "search-engine",
    "information-retrieval",
    "inverted-index",
    "bm25",
    "okapi-bm25",
    "porter-stemmer",
    "web-crawler",
    "concurrency",
    "worker-pool",
    "nodejs"
  ],
  "license": "MIT",
  "dependencies": {
    "cheerio": "1.0.0",
    "express": "^4.19.2"
  }
}
